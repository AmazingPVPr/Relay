# Intentionally no ALSA, Bluetooth, session manager, device enumeration,
# process launcher, or host D-Bus connection. The runner replaces @...@.
context.properties = {
    core.daemon = true
    core.name = @REMOTE@
    default.clock.rate = 48000
    default.clock.quantum = 480
    default.clock.min-quantum = 480
    default.clock.max-quantum = 480
}
context.spa-libs = {
    audio.convert.* = audioconvert/libspa-audioconvert
    support.* = support/libspa-support
}
context.modules = [
    { name = libpipewire-module-protocol-native }
    { name = libpipewire-module-metadata }
    { name = libpipewire-module-spa-node-factory }
    { name = libpipewire-module-client-node }
    { name = libpipewire-module-client-device }
    { name = libpipewire-module-adapter }
    { name = libpipewire-module-link-factory }
    { name = libpipewire-module-access args = { access.force = unrestricted } }
    { name = libpipewire-module-protocol-pulse args = {
        server.address = [ "unix:@PULSE_SOCKET@" ]
    } }
]
context.objects = [
    { factory = spa-node-factory args = {
        factory.name = support.node.driver
        node.name = Relay-Regression-Driver
        node.group = relay.audio.regression
        priority.driver = 20000
    } }
    { factory = adapter args = {
        factory.name = support.null-audio-sink
        node.name = @SINK@
        node.description = Relay-Silent-Regression
        media.class = Audio/Sink
        node.virtual = true
        node.pause-on-idle = false
        audio.rate = 48000
        audio.position = [ FL FR ]
        adapter.auto-port-config = { mode = dsp monitor = true position = preserve }
    } }
]
stream.properties = { adapter.auto-port-config = { mode = dsp } }
